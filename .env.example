# Coffee BI - Firebase Cloud Firestore
APP_ENV=development
FIREBASE_PROJECT_ID=seu-firebase-project-id
# Em servidor externo/local: caminho absoluto para JSON de conta de serviço.
# Nunca comite esse arquivo, nem inclua segredos no ZIP público.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/firebase-service-account.json
# Em Google Cloud Run use Application Default Credentials (sem JSON).
# Em desenvolvimento com Firebase Emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
BUSINESS_TIMEZONE=America/Sao_Paulo
# Gerar com python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Em produção, URL HTTPS pública do ERP.
# PUBLIC_ORIGIN=https://erp.seu-dominio.com
