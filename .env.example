# Coffee BI - Firebase Cloud Firestore (projeto: business-inteli)
# Este arquivo e apenas um modelo. Copie para .env e nunca publique credenciais.
APP_ENV=development
FIREBASE_PROJECT_ID=business-inteli

# Computador Windows ou Linux: caminho ABSOLUTO para sua chave privada
# criada no Firebase Console > Configuracoes do projeto > Contas de servico.
# Armazene a chave FORA da pasta do repositorio; exemplo Windows:
# GOOGLE_APPLICATION_CREDENTIALS=G:/firebase-private/business-inteli-service-account.json
# Google Cloud Run: prefira ADC com IAM; nao configure JSON se disponivel.
# Google Cloud SDK local (alternativa): gcloud auth application-default login

# Firestore Emulator so para desenvolvimento, caso escolha BI init --emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

BUSINESS_TIMEZONE=America/Sao_Paulo
# BI init gera um segredo forte automaticamente se estiver vazio em desenvolvimento.
# Para gerar manualmente: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Em producao defina HTTPS e APP_ENV=production:
# PUBLIC_ORIGIN=https://erp.seu-dominio.com
