

# ==================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ==================================

# PostgreSQL (Para produção - descomente e configure se necessário)
DATABASE_URL=postgresql://postgres:root@localhost:5433/cafeteria

# ==================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ==================================

# Nome da Aplicação
APP_NAME="ERP Cafeteria"

# Ambiente (development, staging, production)
ENVIRONMENT=development

# Debug Mode (True para desenvolvimento, False para produção)
DEBUG=True

# ==================================
# CONFIGURAÇÕES DE SEGURANÇA
# ==================================

# Secret Key para sessões (gerar uma nova em produção)
# Para gerar: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=sua_chave_secreta_aqui_mude_em_producao

# Tempo de expiração de sessão (em minutos)
SESSION_TIMEOUT=480

# ==================================
# CONFIGURAÇÕES DE BACKUP
# ==================================

# Diretório para backups automáticos
BACKUP_DIR=./backups

# Intervalo de backup automático (em horas)
BACKUP_INTERVAL=24

# ==================================
# CONFIGURAÇÕES DE EMAIL (OPCIONAL)
# ==================================

# Para notificações por email
EMAIL_HOST=testeaccaunt.gmail.com
EMAIL_PORT=587
EMAIL_USER=testeaccaunt@gmail.com
EMAIL_PASSWORD=teste123
EMAIL_FROM=noreply@cafeteria.com

# ==================================
# CONFIGURAÇÕES DE LOGS
# ==================================

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=./logs/cafeteria.log

# ==================================
# CONFIGURAÇÕES REGIONAIS
# ==================================

# Timezone
TIMEZONE=America/Sao_Paulo

# Formato de moeda
CURRENCY=BRL

# Idioma
LANGUAGE=pt-BR

# ==================================
# CONFIGURAÇÕES ESPECÍFICAS DO NEGÓCIO
# ==================================

# Margem de lucro padrão (%)
DEFAULT_PROFIT_MARGIN=30

# Taxa de serviço (%)
SERVICE_TAX=10

# Estoque mínimo padrão
DEFAULT_MIN_STOCK=10